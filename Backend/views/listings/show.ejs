<% layout("/layouts/boilerplate") %>

<div class="row">

    <div class="col-8 offset-1 mt-3 mb-2">
        <h3>
            <b><%=listing.title%></b>
        </h3>
    </div>

    <div class="cards col-6 offset-1 show-card">

        <img src="<%=listing.image.url%>"
             class="card-img-top show-img"
             alt="<%=listing.title%> image">

        <div class="card-body mb-2">
            <p class="card-text">
                
                <%=listing.description%> <br>
                ₹<%= listing.price != null
                ? listing.price.toLocaleString("en-IN")
                : "Price unavailable" %><br>
                <%=listing.location%> <br>
                <%=listing.country%>
            </p>
        </div>

    </div>

    <div class="btns mb-4">

        <a href="/listings/<%=listing._id%>/edit"
           class="btn btn-dark col-1 offset-1 edit-btn">
            Edit
        </a>

        <form method="POST"
              action="/listings/<%=listing._id%>?_method=DELETE">

            <button class="btn btn-dark offset-3">
                Delete
            </button>

        </form>

    </div>
        <hr>
    <div class="col-8 offset-1">
        <h5><b>Leave a Review</b></h5>
    </div>
    <div class="col-8 offset-3">
       
        <form action="/listings/<%=listing._id%>/review" method="post">
            <div class="mb-3 mt-3">
                <label for="rating"  class="form label">Rating:</label>
                <input id="rating" type="range" min="1" max="5" name="review[rating]" novalidate class="needs-validation"/>
            </div>
            <div class="mb-3 mt-3">
                <label for="cmnt" class="form label">Comment:</label>
                <div class="col-8 offset-1">
                    <textarea  id="cmnt" rows="5" cols="40" placeholder="Leave a comment" name="review[comment]" novalidate class="needs-validation"></textarea>
                </div>
            </div>
            <button class="btn btn-dark mb-3 mt-3">Submit</button>
        </form>
    </div>

</div>