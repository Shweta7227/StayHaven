<% layout("/layouts/boilerplate") %>

    <body>
        <div class="row">
            <div class="col-8 offset-1 mt-3">
                
                <h3>Edit the Listing</h3>
                <form method="POST" action="/listings/<%=listing._id%>?_method=PUT">
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input name="listings[title]" value="<%=listing.title%>" type="text" class="form-control">

                    </div>

                    <div class="mb-3">
                        <label for="title" class="form-label">Description</label>
                        <textarea name="listings[description]" class="form-control"> <%=listing.description%></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="title" class="form-label">Image Link</label>
                        <input name="listings[image][url]" value="<%= listing.image?.url || '' %>" type="url" class="form-control" >
                    <div class="row">
                        <div class="mb-3 col-md-4">
                            <label for="title" class="form-label">Price</label>
                            <input name="listings[price]" placeholder="1200" type="number" min="0" class="form-control" required>

                        </div>
                        <div class="mb-3 col-md-8">
                            <label for="title" class="form-label">Country</label>
                            <input name="listings[country]" value="<%=listing.country%>" type="text" class="form-control" required>

                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="title" class="form-label">Location</label>
                        <input name="listings[location]" value="<%=listing.location%>" type="text" class="form-control">

                    </div>
                    <button class="btn btn-dark edit-btn mb-4 ">Updated</button>

                </form>
            </div>
        </div>
    </body>