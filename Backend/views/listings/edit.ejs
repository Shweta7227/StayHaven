<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stay-Haven</title>
</head>
<body>
    <h3>Edit the Listing</h3>
    <form method="POST" action="/listings/<%=listing._id%>?_method=PUT">
        <input name="listings[title]" value="<%=listing.title%>" type="text">
        <br> <br>
        <textarea name="listings[description]" rows="10" cols="30"> <%=listing.description%></textarea>
        <br> <br>
        <input name="listings[image]" value="<%=listing.image%>" type="text">
        <br> <br>
        <input name="listings[price]" value="<%=listing.price%>" type="number">
        <br> <br>
        <input name="listings[location]"value="<%=listing.location%>" type="text">
        <br> <br>
        <input name="listings[country]" value="<%=listing.country%>" type="text">
        <br> <br>
        <button>Updated</button>

    </form>
</body>
</html>