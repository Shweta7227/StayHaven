<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stay-Haven</title>
</head>
<body>
    <h3>Create a new Listing</h3>
    <form method="POST" action="/listings">
        <input name="listings[title]" placeholder="Enter title" type="text">
        <br> <br>
        <textarea name="listings[description]" placeholder="Enter description" type="text"></textarea>
        <br> <br>
        <input name="listings[image]" placeholder="Enter image url /Link" type="text">
        <br> <br>
        <input name="listings[price]" placeholder="Enter price" type="number">
        <br> <br>
        <input name="listings[location]" placeholder="Enter location" type="text">
        <br> <br>
        <input name="listings[country]" placeholder="Enter country" type="text">
        <br> <br>
        <button>Add</button>

    </form>
</body>
</html>